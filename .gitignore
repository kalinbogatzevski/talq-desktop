# Re-include the mingw import lib for vendored ONNX Runtime. The .a is
# generated locally via gendef + dlltool from the redistributed DLL
# (Microsoft, MIT) and must travel with the repo so clones build out of
# the box without re-running the dlltool step.
!third_party/onnxruntime/lib/libonnxruntime.dll.a
CMakeUserPresets.json
.cache/
aqtinstall.log
.superpowers/

# Private/branded assets — never published. Canonical store is /private;
# the 123NET build restores these into the tree at build time (kept ignored
# here so a restored working copy can't be committed).
/private/
signing/
resources/123net-*
installer/123net-talk-setup.iss
